{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/((?!api/|assets/|flashcards|.*\\.).*)", "destination": "/flashcards", "permanent": false }
  ],
  "rewrites": [
    { "source": "/flashcards", "destination": "/flashcards.html" },
    { "source": "/((?!api/|flashcards).*)", "destination": "/index.html" }
  ]
}
